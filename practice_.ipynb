    "randomNum = random.randrange(1,10)\n",
    "\n",
    "while True:\n",
    "    userInput = int(input(\"Enter Num : \"))\n",
    "    if userInput == randomNum:\n",
    "        print(\"Correct\")\n",
    "        break\n",
    "    elif userInput > randomNum:\n",
    "        print(\"Too High\")\n",
    "    else:\n",
    "        print(\"Too low\")"
